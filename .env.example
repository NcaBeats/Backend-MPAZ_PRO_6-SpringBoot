# MPAZ PRO 6 - Variables de entorno (ejemplo)
# Copiar a .env y ajustar segun el entorno:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# Ruta del archivo SQLite (relativa al directorio de ejecucion o absoluta).
# El directorio se crea solo; la base se inicializa en el primer arranque.
SQLITE_PATH=./data/mpaz.db
# Puerto donde escucha la aplicacion Spring Boot
SERVER_PORT=8080
