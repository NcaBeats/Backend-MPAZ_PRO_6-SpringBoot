# MPAZ PRO 6 - Variables de entorno (ejemplo)
# Copiar a .env y ajustar segun el entorno:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)

# PostgreSQL local (ver compose.yaml)
POSTGRES_DB=mpaz
POSTGRES_USER=mpaz
POSTGRES_PASSWORD=mpaz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Secreto HS256 para los JWT. Cambiar en cualquier entorno real.
MPAZ_JWT_SECRET=cambiar-este-secreto-de-al-menos-32-bytes

# Puerto donde escucha la aplicacion Spring Boot
SERVER_PORT=8080
