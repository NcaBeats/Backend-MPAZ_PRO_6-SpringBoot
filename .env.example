# MPAZ PRO 6 - Variables de entorno (ejemplo)
# Copiar a .env y ajustar segun el entorno:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# --- PostgreSQL ---
POSTGRES_DB=mpaz
POSTGRES_USER=mpaz
POSTGRES_PASSWORD=mpaz
# Puerto del host donde se publica Postgres (contenedor -> 5432)
POSTGRES_PORT=5432
# Host de la BD cuando la app corre fuera de Docker (en compose se sobreescribe a "db")
DB_HOST=localhost

# --- Aplicacion ---
SERVER_PORT=8080
# Puerto del host donde se publica la app en compose
APP_PORT=8080
