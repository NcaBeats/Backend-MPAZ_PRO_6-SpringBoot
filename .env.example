# MPAZ PRO 6 - Variables de entorno (ejemplo)
# Copiar a .env y ajustar segun el entorno:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# Nombre de la base de datos PostgreSQL
POSTGRES_DB=mpaz
# Usuario de la base de datos
POSTGRES_USER=mpaz
# Contrasena de la base de datos (cambiar en entornos reales)
POSTGRES_PASSWORD=secret
# Puerto expuesto del contenedor PostgreSQL (cambiar si el 5432 esta ocupado)
POSTGRES_PORT=5432
# Host donde corre PostgreSQL (la app lo usa en el JDBC URL)
DB_HOST=localhost
# Puerto donde escucha la aplicacion Spring Boot
SERVER_PORT=8080
