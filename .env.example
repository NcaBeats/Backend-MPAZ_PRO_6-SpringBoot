# MPAZ PRO 6 - Variables de entorno (ejemplo)
# Copiar a .env y ajustar segun el entorno:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# Nombre de la base de datos
POSTGRES_DB=mpaz
# Usuario de la base de datos
POSTGRES_USER=mpaz
# Contrasena de la base de datos (cambiar en entornos reales)
POSTGRES_PASSWORD=secret

# Puerto expuesto de PostgreSQL (opcional, por defecto 5432).
# Descomentar solo si el 5432 esta ocupado en tu maquina.
# POSTGRES_PORT=5432

# Host de la BD (opcional, por defecto localhost).
# Descomentar solo si la BD no esta en tu maquina local.
# DB_HOST=localhost

# Puerto de la aplicacion (opcional, por defecto 8080).
# Descomentar y cambiar solo si el 8080 esta ocupado o quieres otro puerto.
# SERVER_PORT=8080
